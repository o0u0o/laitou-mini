.container {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--color-bg);
    min-height: 100vh;
}

.icon {
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 80rpx;
    line-height: 160rpx;
    text-align: center;
    margin-top: 80rpx;
}

.title {
    font-size: 36rpx;
    font-weight: 600;
    color: var(--color-text);
    margin-top: var(--space-lg);
}

.desc {
    font-size: 26rpx;
    color: var(--color-text-2);
    line-height: 1.7;
    margin-top: var(--space-md);
    text-align: center;
    padding: 0 var(--space-md);
}

.steps {
    width: 100%;
    background-color: #FFFFFF;
    border-radius: 12rpx;
    padding: var(--space-md);
    margin-top: var(--space-lg);
}

.step {
    display: flex;
    align-items: flex-start;
    padding: var(--space-sm) 0;
    font-size: 26rpx;
    color: var(--color-text-2);
    line-height: 1.6;
}

.step-no {
    flex-shrink: 0;
    width: 36rpx;
    height: 36rpx;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: #FFFFFF;
    font-size: 22rpx;
    line-height: 36rpx;
    text-align: center;
    margin-right: var(--space-sm);
}

.actions {
    width: 100%;
    margin-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
}
