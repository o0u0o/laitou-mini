<wxs module="tagColor">
  /**
   * 根据公司/机构类型返回标签的语义化配色
   *  - 诈骗 / 传销 → 红色（danger）
   *  - 培训 / 疑似 → 橙色（warning）
   *  - 其它       → 主色绿（primary）
   */
  module.exports = function (type) {
    if (!type) return { bg: '#F0F2F5', font: '#666666' };
    if (type.indexOf('诈骗') > -1 || type.indexOf('传销') > -1) {
      return { bg: '#FDECEC', font: '#D94F4F' };
    }
    if (type.indexOf('培训') > -1 || type.indexOf('疑似') > -1) {
      return { bg: '#FEF4E5', font: '#E8A33D' };
    }
    return { bg: '#E8F3EF', font: '#157658' };
  }
</wxs>

<view class="container">
  <!-- Hero 顶部品牌区（仿"看准"风格：深色渐变背景 + 大标题 + 大圆角搜索框） -->
  <view class="hero">
    <view class="hero-brand">来头</view>
    <view class="hero-title">求职前先查一查</view>
    <view class="hero-sub">基于公开信息与可核验事实，看清这家公司的来头</view>

    <l-search-bar class="hero-search"
                  l-container-class="hero-search-container"
                  l-class="hero-search-input"
                  l-placeholder-class="hero-search-placeholder"
                  l-icon-class="hero-search-icon"
                  l-cancel-class="hero-search-cancel"
                  placeholder="输入公司名称、机构、关键词"
                  icon-size="36"
                  icon-color="#157658"
                  bg-color="#FFFFFF"
                  shape="circle"
                  show-cancel="{{false}}"
                  bind:linconfirm="endsearchList">
    </l-search-bar>

    <!-- 热门搜索 / 快捷入口 -->
    <view class="hero-tags">
      <view class="hero-tag" data-kw="劳动争议" bindtap="onTagTap">劳动争议</view>
      <view class="hero-tag" data-kw="行政处罚" bindtap="onTagTap">行政处罚</view>
      <view class="hero-tag" data-kw="失信被执行" bindtap="onTagTap">失信被执行</view>
      <view class="hero-tag" data-kw="疑似传销" bindtap="onTagTap">疑似传销</view>
    </view>
  </view>

  <!-- 合规提示条 -->
  <view class="disclaimer">
    来头 · 求职前先查一查：平台内容仅作求职风险参考，不构成对企业的最终定性。发现失实可 <text class="link" bindtap="goAppeal">申诉、反馈</text>。
  </view>

  <!-- 分区标题 -->
  <view class="section-header">
    <view class="section-title">风险线索</view>
    <view class="section-extra">仅供参考</view>
  </view>

  <!-- 卡片列表 START -->
  <block wx:for="{{companyData.companys}}" wx:key="id">
    <view class="card-companys">
      <l-card type="avatar"
              l-class="card"
              image="{{item.logo}}"
              title="{{item.name}}"
              describe="地址：{{item.province}} / {{item.city}} / {{item.district}}">
        <view class="card-content">
          <view><text>详细地址：{{item.address}}</text></view>
          <view><text>信息来源：{{item.source}}</text></view>
        </view>
        <l-tag shape="circle"
               bg-color="{{tagColor(item.type).bg}}"
               font-color="{{tagColor(item.type).font}}"
               slot="more"
               size="large">
          {{item.type}}
        </l-tag>
      </l-card>
    </view>
  </block>
  <!-- 卡片列表 END -->

  <!-- 页脚合规入口 -->
  <view class="footer-links">
    <text class="link" bindtap="goNotice">投稿须知</text>
    <text class="sep">·</text>
    <text class="link" bindtap="goPrivacy">隐私政策</text>
    <text class="sep">·</text>
    <text class="link" bindtap="goAppeal">申诉 / 反馈</text>
  </view>
</view>

