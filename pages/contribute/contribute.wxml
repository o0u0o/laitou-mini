<view class="container">
    <!-- 顶部合规提示 -->
    <view class="notice-bar">
        投稿默认<text class="link" bindtap="goNotice">不公开</text>，需先通过审核。提交即视为同意
        <text class="link" bindtap="goNotice">《投稿须知》</text>与
        <text class="link" bindtap="goPrivacy">《隐私政策》</text>。
    </view>

    <view class="feedback">
        <view>
            <l-input
                    label-width="270"
                    clear="{{true}}"
                    bind:linblur="bindName"
                    label="公司/机构名字"
                    placeholder="请输入公司名称" required="{{true}}">
            </l-input>
            <l-input
                    label-width="270"
                    clear="{{true}}"
                    label="类型"
                    bind:linblur="bindType"
                    placeholder="如：劳动争议/行政处罚/失信被执行 等可核验类别" required="{{true}}">
            </l-input>
            <l-input
                    label-width="270"
                    bind:linblur="bindProvince"
                    label="省/直辖市/自治区" placeholder="如：广东省" required="{{true}}">
            </l-input>
            <l-input
                    label-width="270"
                    bind:linblur="bindCity"
                    label="城市" placeholder="如：深圳市" require="{{true}}"></l-input>
            <l-input
                    label-width="270"
                    bind:linblur="bindDistrict"
                    label="区/县" placeholder="如：南山区"></l-input>
            <l-input
                    label-width="270"
                    bind:linblur="bindAddress"
                    label="详细地址" placeholder="如：某某大厦1987楼8号"></l-input>
        </view>
        <view class="remark">
            <l-textarea indicator="{{true}}"
                        maxlength="500"
                        bind:linblur="bindRemark"
                        placeholder="请客观陈述事实，并附可核验来源（如裁判文书编号、媒体报道链接）。请勿包含他人身份证号、手机号等隐私信息。">
            </l-textarea>
        </view>

        <!-- 同意确认 -->
        <view class="agree" bindtap="toggleAgree">
            <view class="check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view>
            <view>
                我已阅读并同意
                <text class="link" catchtap="goNotice">《投稿须知》</text>与
                <text class="link" catchtap="goPrivacy">《隐私政策》</text>，
                承诺所提交内容真实、合法，不含他人隐私或不实指控。
            </view>
        </view>
    </view>

    <!--  提交  -->
    <view class="submit">
        <l-button type="success" bind:lintap="submitData">提交</l-button>
        <view class="tips">提交后进入审核池，审核通过后才会公开展示。</view>
    </view>

    <l-toast />
</view>


